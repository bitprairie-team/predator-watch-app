{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "predator-watch-map",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true },
  // Copies MapLibre into public/vendor before dev and deploy.
  "build": { "command": "node scripts/copy-vendor.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Let the Worker handle /api/* and /ogc/*; everything else is a static asset.
    "run_worker_first": ["/api/*", "/ogc", "/ogc/*"]
  },
  // Normalized GeoJSON cache. For local dev, wrangler simulates KV on disk and
  // this id is not used. Before deploying, create a namespace with
  // `npx wrangler kv namespace create LAYER_CACHE` and paste its id here.
  "kv_namespaces": [
    { "binding": "LAYER_CACHE", "id": "a923d084b1f4495e833c453b16e4275e" }
  ],
  // Refresh sources every 15 minutes. Each source also has its own minimum
  // refresh interval, so slow-changing layers are only checked when due.
  "routes": [{ "pattern": "app.predatorwatch.org", "custom_domain": true }],
  "triggers": { "crons": ["*/15 * * * *"] },
  // Per-client rate limits (Workers Rate Limiting; counts are per Cloudflare
  // location and approximate). namespace_id values must be unique in the
  // account; change them if they clash. See src/lib/ratelimit.ts.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "47101", "simple": { "limit": 600, "period": 60 } },
    { "name": "EXPORT_LIMITER", "namespace_id": "47102", "simple": { "limit": 60, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "47103", "simple": { "limit": 30, "period": 60 } },
    // One shared key: caps calls to the Census address geocoder from this Worker.
    { "name": "UPSTREAM_LIMITER", "namespace_id": "47104", "simple": { "limit": 10, "period": 10 } }
  ],
  "vars": {
    "USER_AGENT": "predator-watch-app/0.1 (+https://github.com/bitprairie-team/predator-watch-app)"
  }
  // Secrets (optional): `npx wrangler secret put ARCGIS_API_KEY`.
  // Locally, put them in .dev.vars (gitignored).
}
