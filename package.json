{
  "name": "predator-watch-app",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source public map of agency-published predator data.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steelhead99x/predator-watch-app.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "refresh": "node scripts/refresh.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "app:assets": "node scripts/app-assets.mjs",
    "store:shots": "node scripts/store-screenshots.mjs",
    "build:native": "node scripts/build-native.mjs",
    "cap:sync": "npm run build:native && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "rollup": "4.60.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
