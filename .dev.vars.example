# Copy to .dev.vars for local development. Never commit .dev.vars.
# Optional: an ArcGIS API key, only needed for sources marked useApiKey: true.
# ARCGIS_API_KEY=

# Rancher assistant (private plan). Text chat and voice use xAI Grok.
# Get a key from the xAI console. Never commit it.
# XAI_API_KEY=
# Optional overrides:
# MODEL_PROVIDER=xai
# XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=eve
